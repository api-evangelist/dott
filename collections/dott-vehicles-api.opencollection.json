{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dott GBFS Discovery Vehicles API",
    "version": "2.3"
  },
  "items": [
    {
      "info": {
        "name": "Vehicles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Vehicle types available in a city",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gbfs.api.ridedott.com/public/v2/:city/vehicle_types.json",
            "params": [
              {
                "name": "city",
                "value": "espoo",
                "type": "path",
                "description": "City slug as listed in the discovery document (e.g. espoo, brussels, warsaw)."
              }
            ]
          },
          "docs": "Vehicle types available in a city"
        },
        {
          "info": {
            "name": "Real-time free-floating vehicle status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gbfs.api.ridedott.com/public/v2/:city/free_bike_status.json",
            "params": [
              {
                "name": "city",
                "value": "espoo",
                "type": "path",
                "description": "City slug as listed in the discovery document (e.g. espoo, brussels, warsaw)."
              }
            ]
          },
          "docs": "Location, range and availability of every free-floating vehicle in the city."
        }
      ]
    }
  ],
  "bundled": true
}